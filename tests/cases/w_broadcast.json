{
  "format": "vliw-testcase/1",
  "name": "w_broadcast",
  "description": "B=1 の rs1 は1つのレジスタで、両方のレーンに使う。奇数のレジスタ（r1）からブロードキャストし、r2 は入力宣言しない（組として読めば L8）。rs1 は rd の組の r[rd+1] でもよく、rd = rs3 の累算でも発行サイクルの旧い値を読む",
  "machine": "config/machine-mvp2.json",
  "program": [
    "@0: vmul r4:r5, r1, r6:r7        ; 3 * 5 = 15 and 3 * (2^32-1) = 2^32 - 3",
    "@1: nop",
    "@2: vmac r4:r5, r5, r8:r9, r4:r5 ; (2^32-3) * 10 + 15 and (2^32-3) * 20 + (2^32-3)",
    "@3: nop",
    "@4: halt"
  ],
  "inputs": {
    "registers": {
      "r1": 3,
      "r6": 5,
      "r7": "0xFFFFFFFF",
      "r8": 10,
      "r9": 20
    },
    "memory": {}
  },
  "expect": {
    "verdict": "legal",
    "cycles": 5,
    "registers": {
      "r4": "0xFFFFFFF1",
      "r5": "0xFFFFFFC1"
    }
  }
}
