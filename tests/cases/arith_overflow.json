{
  "format": "vliw-testcase/1",
  "name": "arith_overflow",
  "description": "ADD/SUB/MULは2^32を法とする（下位32bit）",
  "program": [
    "@0: add r5, r1, r2      ; 0xFFFFFFFF + 1 = 0",
    "@1: sub r6, r0, r2      ; 0 - 1 = 0xFFFFFFFF",
    "@2: mul r7, r3, r3      ; 0x10000 * 0x10000 = 2^32 -> 0",
    "@3: mul r8, r1, r1      ; (2^32-1)^2 = 1 (mod 2^32)",
    "@4: mul r9, r4, r1      ; 3 * (2^32-1) = 0xFFFFFFFD",
    "@5: nop",
    "@6: halt"
  ],
  "inputs": {
    "registers": {
      "r0": 0,
      "r1": "0xFFFFFFFF",
      "r2": 1,
      "r3": "0x10000",
      "r4": 3
    },
    "memory": {}
  },
  "expect": {
    "verdict": "legal",
    "cycles": 7,
    "registers": {
      "r5": 0,
      "r6": "0xFFFFFFFF",
      "r7": 0,
      "r8": 1,
      "r9": "0xFFFFFFFD"
    }
  }
}
