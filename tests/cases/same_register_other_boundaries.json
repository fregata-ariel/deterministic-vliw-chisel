    "@3: halt"
  ],
  "inputs": {
    "registers": {
      "r2": 2,
      "r3": 3
    },
    "memory": {
      "0": 9
    }
  },
  "expect": {
    "verdict": "legal",
    "cycles": 4,
    "registers": {
      "r1": 9
    }
  }
