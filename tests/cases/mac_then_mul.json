{
  "format": "vliw-testcase/1",
  "name": "mac_then_mul",
  "description": "MAC(s) と MUL(s+1) は、latency 2 では E_(s+2) と E_(s+3) に commit し、衝突しない",
  "machine": "config/machine-mvp1.json",
  "program": [
    "@0: mac r4, r1, r2, r3   ; 2 * 3 + 4 = 10",
    "@1: mul r5, r1, r2       ; 6",
    "@2: nop",
    "@3: halt"
  ],
  "inputs": {
    "registers": {
      "r1": 2,
      "r2": 3,
      "r3": 4
    },
    "memory": {}
  },
  "expect": {
    "verdict": "legal",
    "cycles": 4,
    "registers": {
      "r4": 10,
      "r5": 6
    }
  }
}
