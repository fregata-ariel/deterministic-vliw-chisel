{
  "format": "vliw-testcase/1",
  "name": "overlapping_mul_ld",
  "description": "MULとLDの書込み区間が重なる（L4）",
  "program": [
    "@0: mul r1, r2, r3                ; r1 [0, 2)",
    "@1: nop            | ld r1, [0]   ; r1 [1, 3)",
    "@2: nop",
    "@3: halt"
  ],
  "inputs": {
    "registers": {
      "r2": 1,
      "r3": 1
    },
    "memory": {
      "0": 7
    }
  },
  "expect": {
    "verdict": {
      "illegal": [
        "L4"
      ]
    }
  }
}
