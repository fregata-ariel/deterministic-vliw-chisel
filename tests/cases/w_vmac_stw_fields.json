{
  "format": "vliw-testcase/1",
  "name": "w_vmac_stw_fields",
  "description": "VMAC と ST.W も欄4で、読出しポートが3本の構成では不正（L11）。組の欄も1と数える",
  "machine": "config/machine-mvp2.json",
  "program": [
    "@0: vmac r4:r5, r2:r3, r6:r7, r8:r9 | st.w [0], r10:r11",
    "@1: nop",
    "@2: halt"
  ],
  "inputs": {
    "registers": {
      "r2": 1,
      "r3": 2,
      "r6": 3,
      "r7": 4,
      "r8": 5,
      "r9": 6,
      "r10": 7,
      "r11": 8
    },
    "memory": {}
  },
  "expect": {
    "verdict": {
      "illegal": [
        "L11"
      ]
    }
  }
}
