{
  "format": "vliw-testcase/1",
  "name": "slow_units_too_early",
  "description": "MUL のレイテンシーが3の構成では、既定構成で合法な s+2 での読出しが L3 違反になる",
  "machine": "tests/machines/slow_units.json",
  "program": [
    "@0: mul r3, r1, r2",
    "@1: nop",
    "@2: nop            | st [0], r3   ; r3 is in flight until 3",
    "@3: nop",
    "@4: halt"
  ],
  "inputs": {
    "registers": {
      "r1": 2,
      "r2": 3,
      "r3": 0
    },
    "memory": {}
  },
  "expect": {
    "verdict": {
      "illegal": [
        "L3"
      ]
    }
  }
}
