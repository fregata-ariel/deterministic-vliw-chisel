{
  "format": "vliw-testcase/1",
  "name": "w_pair_overlap",
  "description": "組の書込みは、どちらかのレジスタへのスカラーの書込みと重なる。同じ bundle の VMAC r4:r5 と LD r5 は、r5 の区間 [0, 2) が重なる（L4）",
  "machine": "config/machine-mvp2.json",
  "program": [
    "@0: vmac r4:r5, r2, r6:r7, r8:r9 | ld r5, [0]",
    "@1: nop",
    "@2: halt"
  ],
  "inputs": {
    "registers": {
      "r2": 1,
      "r6": 2,
      "r7": 3,
      "r8": 4,
      "r9": 5
    },
    "memory": {
      "0": 6
    }
  },
  "expect": {
    "verdict": {
      "illegal": [
        "L4"
      ]
    }
  }
}
