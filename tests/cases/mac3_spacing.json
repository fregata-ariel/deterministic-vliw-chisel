{
  "format": "vliw-testcase/1",
  "name": "mac3_spacing",
  "description": "MAC のレイテンシーが3の構成。結果は s+3 から見える",
  "machine": "tests/machines/mvp1_mac3.json",
  "program": [
    "@0: mac r4, r1, r2, r3   ; 2 * 3 + 4 = 10, visible from 3",
    "@1: nop",
    "@2: nop",
    "@3: mac r5, r4, r1, r4   ; 10 * 2 + 10 = 30",
    "@4: nop",
    "@5: nop",
    "@6: halt"
  ],
  "inputs": {
    "registers": {
      "r1": 2,
      "r2": 3,
      "r3": 4
    },
    "memory": {}
  },
  "expect": {
    "verdict": "legal",
    "cycles": 7,
    "registers": {
      "r4": 10,
      "r5": 30
    }
  }
}
